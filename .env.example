# ShowBook Backend Configuration
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/showbook
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/showbook?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/showbook
# Dynamic Admin Panel Route (customize or obscure the admin URL, e.g. /admin, /secret-admin, /dashboard)
VITE_ADMIN_ROUTE=/admin
ADMIN_ROUTE=/admin
